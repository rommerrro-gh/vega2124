{
  "name": "pulse-doma-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=esm --target=es2020 --outdir=../app-bootstrap/src/main/resources/static/miniapp --entry-names=bundle",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write \"src/**/*.{jsx,mjs,css}\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{jsx,mjs,css}\" \"test/**/*.mjs\""
  },
  "dependencies": {
    "@maxhub/max-ui": "0.5.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "jsdom": "26.1.0",
    "prettier": "3.9.10"
  }
}
